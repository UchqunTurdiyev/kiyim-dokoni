# Telegram bot (BotFather dan olingan token)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Arizalar keladigan chat/guruh ID (guruh bo'lsa -100 bilan boshlanadi)
TELEGRAM_CHAT_ID=-1001234567890

# Rahmat sahifasidan keyin o'tadigan Telegram kanal
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/your_channel

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
# Test qilish uchun (Events Manager > Test events). Ishga tushirganda bo'sh qoldiring
META_TEST_EVENT_CODE=

# Saytning ochiq manzili (Telegram tugmasidagi link uchun). HTTPS bo'lishi shart!
NEXT_PUBLIC_SITE_URL=https://your-domain.uz

# Lid linkini shifrlash kaliti (ixtiyoriy, tavsiya). Bo'sh bo'lsa TELEGRAM_BOT_TOKEN'dan avtomatik olinadi.
# Yaratish: openssl rand -hex 32
# DIQQAT: o'zgartirsangiz, eski Telegram tugmalari ishlamay qoladi
LEAD_TOKEN_SECRET=change_me_to_a_long_random_string_64_chars_xxxxxxxxxxxxxxxx
# Link amal qilish muddati (kun)
LEAD_TOKEN_TTL_DAYS=30

# Sotuvchilar to'lovni tasdiqlashda kiritadigan PIN kod (ixtiyoriy; bo'sh bo'lsa PIN so'ralmaydi)
SALES_PIN=4821

# Purchase hodisasi manbasi: website (tavsiya — reklama optimizatsiyasi uchun) yoki phone_call / system_generated
META_PURCHASE_ACTION_SOURCE=website
