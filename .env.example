# Telegram bot (BotFather dan olingan token)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Arizalar keladigan chat/guruh ID (guruh bo'lsa -100 bilan boshlanadi)
TELEGRAM_CHAT_ID=-1001234567890

# Rahmat sahifasidan keyin o'tadigan Telegram kanal
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/your_channel

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
# Test qilish uchun (Events Manager > Test events). Ishga tushirganda bo'sh qoldiring
META_TEST_EVENT_CODE=
